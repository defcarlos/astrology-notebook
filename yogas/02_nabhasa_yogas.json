            "id": "yoga_rajju",
            "name": "Rajju Yoga",
            "category": "Nabhasa Asraya",
            "description": "All 7 visible planets located in moveable (Chara) signs.",
            "results": "The native will be fond of travel, wandering, and may frequently live in foreign lands. Highly adaptable but may lack stability, sometimes exhibiting a cruel streak.",
            "rules": {
                "logical_operator": "ALL",
                "conditions": [
                    {
                        "target": "AllPlanets",
                        "exclude": [
                            "Rahu",
                            "Ketu"
                        ],
                        "property": "sign_quality",
                        "operator": "EQUALS",
                        "value": "Moveable"
                    }
                ]
            }
        },
